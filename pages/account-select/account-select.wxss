.container {
  padding: 40rpx;
  min-height: 20vh;
  background-color: #f8f9fa;
}
.header-top {
  display: flex;
  justify-content: center; /* 标题居中 */
  align-items: center;
  margin-bottom: 20rpx;
  position: relative; /* 为关闭按钮定位做准备 */
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  text-align: center; /* 确保文本居中 */
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #eee;
  color: #666;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  position: absolute; /* 绝对定位到右侧 */
  right: 0;
}

.close-btn::after {
  border: none;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  text-align: center; /* 副标题也居中 */
}

.account-list {
  margin-bottom: 40rpx;
}

.account-item {
  display: flex;
  align-items: center;
  background: #ffffff; /* 白色背景 */
  padding: 40rpx; /* 增加内边距使区域更宽 */
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05); /* 添加轻微阴影增强层次感 */
  width: 100%; /* 确保宽度占满容器 */
}

.account-item.current {
  border-color: #89CFF0;
  background: #f0f8ff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

/* 新增容器使信息区域水平居中 */
.info-container {
  flex: 1;
  display: flex;
  justify-content: center; /* 水平居中 */
}

.info {
  background-color: #f8f9fa; /* 添加浅灰色背景 */
  padding: 20rpx 40rpx; /* 增加内边距，特别是水平方向 */
  border-radius: 12rpx; /* 圆角 */
  text-align: center; /* 文本居中 */
  width: 100%; /* 占据容器全部宽度 */
  max-width: 400rpx; /* 限制最大宽度 */
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.details {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 5rpx;
}

.actions {
  text-align: right;
}

.current-badge {
  background: #89CFF0;
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.select-btn, .edit-btn {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
  margin: 0;
  min-width: 80rpx;
}

.select-btn {
  background: #89CFF0;
  color: white;
}

.edit-btn {
  background: #f8f9fa;
  color: #666;
  border: 1rpx solid #e9ecef;
}

.select-btn::after, .edit-btn::after {
  border: none;
}

.empty-state {
  text-align: center;
  padding: 60rpx;
  background: white;
  border-radius: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.footer {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
}

.add-btn {
  background: #89CFF0;
  color: white;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 32rpx;
  width: 100%;
}

.add-btn::after {
  border: none;
}