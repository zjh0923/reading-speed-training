page{
  height: 100%;
}

.user-area image{
  width: 200rpx;
  height: 200rpx;
  border-radius: 500%;
}
.user-area .name{
  font-size: 30rpx;
  padding: 30rpx 0;
}

.user-area .logout{
  color: #a94442;
}
.top-view{
  background-color: #89CFF0;
  color: white;
  padding: 40rpx;
}

/* 新增：用户头部容器 */
.top-view .user-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.top-view .user{
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  flex: 1;
}
.top-view .user .row{
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}
.top-view .user .avatar{
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}
.top-view .user .name{
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  padding-left: 20rpx;
  font-size: 36rpx;
  font-weight: bold;
}
.top-view .user .name navigator{
  padding: 0 5rpx;
}

/* 新增：切换账号按钮样式 */
.switch-account-btn {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  margin: 0;
  width: 150rpx;
  height: 80rpx;
  justify-content: center;
  align-items: center;
}

.switch-account-btn::after {
  border: none;
}

.switch-text {
  color: white;
  font-size: 24rpx;
  font-weight: normal;
  padding-bottom:10 rpx;
  justify-content: center;
  align-items: center;

}

.top-view .site{
  background-color: rgba(0, 0, 0, 0.16);
  padding: 20rpx;
  border-top-left-radius: 32rpx;
  border-bottom-left-radius: 32rpx;
}
.top-view .numbers{
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 40rpx;
  padding-bottom: 0rpx;
}
.top-view .numbers .row{
   display: flex;
  flex-direction: column;
  align-items: center;
}
.list {
  background-color: #fff;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}