<view class="container">
  <view class="header">
    <text class="title">速读星</text>
    <text class="subtitle">请输入密码访问内容</text>
  </view>
  
  <view class="content">
    <view class="input-group">
      <text class="label">输入密码</text>
      <view class="input-area">
        <input 
          class="password-input" 
          type="{{isPasswordVisible ? 'text' : 'password'}}" 
          placeholder="请输入6位数字密码" 
          maxlength="6"
          value="{{password}}"
          bindinput="onPasswordInput"
          bindconfirm="onSubmit"
        />
        <view class="toggle-password" bindtap="togglePasswordVisibility">
          <text class="icon">{{isPasswordVisible ? '🙈' : '👁️'}}</text>
        </view>
      </view>
    </view>
    
    <button class="submit-btn" bindtap="onSubmit" disabled="{{!password.length}}">确认</button>
    
    <view class="message {{messageType}}" wx:if="{{message}}">
      {{message}}
    </view>
  </view>
</view>