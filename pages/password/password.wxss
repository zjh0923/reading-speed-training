.container {
  height: 100vh;
  background: linear-gradient(135deg, #89cff0 0%, #89cff0 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  color: white;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.content {
  width: 100%;
  background-color: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.input-group {
  margin-bottom: 60rpx;
}

.label {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.input-area {
  position: relative;
  margin-bottom: 20rpx;
}

.password-input {
  width: 100%;
  height: 88rpx;
  padding: 0 100rpx 0 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 32rpx;
  transition: all 0.3s;
}

.password-input:focus {
  border-color: #1aad19;
}

.toggle-password {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon {
  font-size: 36rpx;
}

.hint {
  font-size: 24rpx;
  color: #888;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1aad19, #0d8b0c);
  color: white;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-btn[disabled] {
  background: #cccccc;
  color: #999999;
}

.message {
  margin-top: 40rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
}

.error {
  background-color: #ffebee;
  color: #d32f2f;
}

.success {
  background-color: #e8f5e9;
  color: #2e7d32;
}