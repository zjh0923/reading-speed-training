.rule{
  width: 600rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 100rpx ;
  margin-bottom: 100rpx;
  margin-left:90rpx;
  font-size: 35rpx;
}
input {
  height:80rpx;
  border: 1rpx solid rgb(7, 7, 7);
  border-radius: 10rpx;
  padding: 10rpx;
  margin: 20rpx;
}
.btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 40rpx auto;
  position: relative;
  background: transparent;
  border: none;
}

.btn::after {
  border: none;
}

.photo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.default-avatar {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}
