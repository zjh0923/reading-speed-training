/* pages/train-records/train-records.wxss *//* pages/train-records/train-records.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.stats-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.stat-item {
  width: 50%;
  margin: 20rpx 0;
}

.stat-label {
  font-size: 28rpx;
  color: #666;
}

.stat-value {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
}

.chart-container {
  height: 500rpx;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
  color: #333;
}

.record-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.day {
  font-size: 30rpx;
  color: #1890ff;
}

.date {
  font-size: 26rpx;
  color: #999;
}

.record-body {
  display: flex;
  justify-content: space-between;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}
.row{
  display: flex;
 flex-direction: column;
 align-items: center;
}
.numbers{
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 40rpx;
  padding-bottom: 0rpx;
}